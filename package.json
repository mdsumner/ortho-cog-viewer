{
  "name": "ortho-cog-viewer",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node tools/bundle-proj-wasm.mjs",
    "dev": "vite",
    "prebuild": "node tools/bundle-proj-wasm.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check-crs": "python3 tools/check-crs.py --engine 'node tools/proj-wasm-engine.mjs'",
    "check-worker": "node tools/check-worker-core.mjs && python3 tools/check-worker-core.py"
  },
  "dependencies": {
    "geotiff": "^2.1.4-beta.1",
    "proj-wasm": "0.1.0-alpha10",
    "proj4": "^2.11.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
